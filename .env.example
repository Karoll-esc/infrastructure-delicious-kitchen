# ==========================================
# DELICIOUS KITCHEN - INFRASTRUCTURE ENVIRONMENT VARIABLES
# ==========================================
# Este archivo define todas las variables de entorno para la infraestructura y servicios backend.
# Copia este archivo a `.env` y configura los valores apropiados para tu ambiente.

# ==========================================
# GENERAL CONFIGURATION
# ==========================================
# Ambiente de ejecución: development | staging | production
NODE_ENV=development

# ==========================================
# INFRASTRUCTURE
# ==========================================

# MongoDB Connection URL
# Development (Docker): mongodb://mongodb:27017
# Production: mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URL=mongodb://mongodb:27017

# RabbitMQ Connection URL
# Development (Docker): amqp://guest:guest@rabbitmq:5672
# Production: amqps://user:pass@rabbitmq.production.com:5671
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# RabbitMQ Management Console
RABBITMQ_MANAGEMENT_URL=http://localhost:15672

# ==========================================
# API GATEWAY (PORT 3000)
# ==========================================
# Puerto donde se ejecuta el API Gateway
API_GATEWAY_PORT=3000

# URLs internas de microservicios (Docker networking)
# Development usa nombres de servicios Docker: http://service-name:port
# Production usa URLs reales de servicios desplegados
ORDER_SERVICE_URL=http://order-service:3001
KITCHEN_SERVICE_URL=http://kitchen-service:3002

# Configuración CORS
CORS_ENABLED=true
# URL del frontend permitida para CORS
# Development: http://localhost:5173
# Production: https://delicious-kitchen.com
CORS_ORIGIN=http://localhost:5173

# Firebase Configuration para API Gateway (Backend)
# Ruta al archivo serviceAccountKey.json (si usas archivo)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# O usa estas variables (obtén valores de serviceAccountKey.json en Firebase Console)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# IMPORTANTE: La private key debe estar en formato con \n literales
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"

# ==========================================
# ORDER SERVICE (PORT 3001)
# ==========================================
ORDER_SERVICE_PORT=3001
# MongoDB URL específica para Order Service
ORDER_MONGODB_URL=mongodb://mongodb:27017/orders

# ==========================================
# KITCHEN SERVICE (PORT 3002)
# ==========================================
KITCHEN_SERVICE_PORT=3002
# MongoDB URL específica para Kitchen Service
KITCHEN_MONGODB_URL=mongodb://mongodb:27017/kitchen-db

# ==========================================
# NOTIFICATION SERVICE (PORT 3003)
# ==========================================
NOTIFICATION_SERVICE_PORT=3003

# ==========================================
# SMTP CONFIGURATION (Email Notifications)
# ==========================================
# Configuración para enviar emails transaccionales cuando los pedidos estén listos
# Esto permite notificar a clientes que no están conectados online (offline notifications)

# OPCIÓN 1: Gmail SMTP (RECOMENDADO para desarrollo/pruebas - GRATIS hasta 500 emails/día)
# IMPORTANTE: Para usar Gmail, debes crear una "Contraseña de Aplicación":
# 1. Ve a tu cuenta de Google > Seguridad (https://myaccount.google.com/security)
# 2. Activa la verificación en dos pasos (requisito obligatorio)
# 3. Busca "Contraseñas de aplicación" y genera una nueva
# 4. Selecciona "Correo" como aplicación y "Otro" como dispositivo
# 5. Copia la contraseña generada (16 caracteres sin espacios) en SMTP_PASSWORD
# 6. NUNCA uses tu contraseña real de Gmail aquí

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM="Delicious Kitchen <noreply@deliciouskitchen.com>"

# URL del frontend para enlaces en emails (donde los clientes ven sus pedidos)
# Development: http://localhost:5173
# Production: https://delicious-kitchen.com
FRONTEND_URL=http://localhost:5173

# OPCIÓN 2: SendGrid SMTP (alternativa para producción - 100 emails/día gratis)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# EMAIL_FROM="Delicious Kitchen <noreply@deliciouskitchen.com>"

# OPCIÓN 3: Mailgun SMTP (alternativa para producción)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@your-domain.mailgun.org
# SMTP_PASSWORD=your-mailgun-smtp-password
# EMAIL_FROM="Delicious Kitchen <noreply@deliciouskitchen.com>"

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES
# ==========================================
# Estas variables se pasan al contenedor de frontend en Docker
# También deben estar definidas en frontend-delicious-kitchen/.env

# URL pública del API Gateway (accesible desde navegador)
# Development: http://localhost:3000
# Production: https://api.delicious-kitchen.com
VITE_API_URL=http://localhost:3000

# URL del servicio de notificaciones SSE
# Development: http://localhost:3003/notifications/stream
# Production: https://notifications.delicious-kitchen.com/stream
VITE_NOTIFICATION_URL=http://localhost:3003/notifications/stream

# Firebase Configuration (Frontend - valores públicos)
VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ==========================================
# NOTAS IMPORTANTES
# ==========================================
# 1. NO subas el archivo .env al repositorio (debe estar en .gitignore)
# 2. Las URLs internas de servicios (ORDER_SERVICE_URL, KITCHEN_SERVICE_URL) usan 
#    nombres de contenedores Docker en development
# 3. Las URLs públicas (VITE_*) deben ser accesibles desde el navegador del cliente
# 4. FIREBASE_PRIVATE_KEY debe mantener los saltos de línea como \n literales
# 5. En producción, usa HTTPS para todas las URLs públicas
# 6. Las variables VITE_* son expuestas al cliente - nunca incluyas secrets
# 7. SMTP_PASSWORD debe ser una "Contraseña de Aplicación" de Gmail, NO tu contraseña real
# 8. El sistema enviará emails automáticamente cuando un pedido cambie a estado "ready"
